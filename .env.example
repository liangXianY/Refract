# 复制为 .env 后填写。.env 已在 .gitignore 中，不会入库。
# 也可以不建 .env，直接用系统环境变量（推荐）

# ---------- 文本主力：文案 / 分镜方案 / 反思评分 ----------
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---------- 视频主力：生成整份动画 HTML ----------
# 中转站（new-api 部署，Anthropic 协议）。填了就会自动接管 video 路由。
CCTQ_API_KEY=
CCTQ_BASE_URL=https://www.cctq.ai
CCTQ_MODEL=claude-opus-5-5

# 没配 CCTQ 时，视频链路回落到 DeepSeek 的 Anthropic 兼容端点（协议一致，能力弱一些）
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 1 = 用内置 mock 数据（不花钱，验证链路）
# 0 = 调真实模型
LLM_MOCK=1

# plan-execute-reflect 的最大迭代轮数
MAX_ROUNDS=2

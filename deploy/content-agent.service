[Unit]
Description=Content Agent (Plan-Execute-Reflect)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/app/content-agent

# API Key 走 EnvironmentFile，权限 600，不进仓库
EnvironmentFile=-/home/ubuntu/app/content-agent/.env
Environment=DATA_DIR=/home/ubuntu/app/content-agent/data
Environment=MAX_ROUNDS=2
Environment=PYTHONUNBUFFERED=1
# 注意：不要在下面再写 Environment=LLM_MOCK=...
# systemd 里 Environment= 的优先级高于 EnvironmentFile=，
# 写死会把 .env 里的开关吃掉，改配置文件不生效（踩过）。

ExecStart=/home/ubuntu/app/content-agent/.venv/bin/python -m uvicorn app.main:app \
    --host 0.0.0.0 --port 8080 --workers 1 --log-level warning \
    --timeout-graceful-shutdown 5

Restart=always
RestartSec=3

# SSE 长连接会让 uvicorn 优雅关闭一直等，不加这条每次重启都要等满 90 秒
# 再被 SIGKILL——部署又慢又粗暴（实测踩过）
TimeoutStopSec=10

# 内存红线：机器只有 1.9G，应用被 OOM 杀掉好过拖死整机（ssh 也会断）
MemoryMax=700M
MemoryHigh=560M

# 基础加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# 不要加 ProtectHome=read-only：应用目录就在 /home 下，
# Python 需要写 __pycache__，只读会导致启动告警
ReadWritePaths=/home/ubuntu/app/content-agent

[Install]
WantedBy=multi-user.target
